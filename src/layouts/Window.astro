---
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// page changes: the old content fades out, then the new content fades in with a small rise
// (keyframes in global.css). they don't overlap, so the two pages never show at once.
// the same fade is set up in CSS for page loads without JS
const swap = {
  old: { name: 'page-out', duration: '100ms', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'page-in', duration: '260ms', delay: '110ms', easing: 'cubic-bezier(.2, .7, .2, 1)', fillMode: 'both' },
};
const pages = [
  { href: '/', label: 'about' },
  { href: '/things', label: 'things' },
  { href: '/links', label: 'links' },
];
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#0d0b1c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // returning visitors who've decoded the name see it as letters straight away (see main.ts)
      try { if (localStorage.getItem('name') === 'bit') document.documentElement.dataset.name = 'bit'; } catch {}
    </script>
    <!-- with JS, pages swap in place and the planet keeps running; without it, links just load -->
    <ClientRouter />
  </head>
  <body>
    <!-- a still of the planet, for when it can't be drawn live (no JS or no WebGL) -->
    <div class="still" aria-hidden="true"></div>
    <canvas id="field" aria-hidden="true" transition:persist></canvas>

    <div class="page">
      <header class="top">
        <a class="home" href="/">{site.domain}</a>
        <nav aria-label="pages">
          {pages.map((p, i) => (
            <a
              class:list={{ on: path === p.href }}
              href={p.href}
              data-key={i + 1}
              aria-current={path === p.href ? 'page' : undefined}
            >{p.label}</a>
          ))}
        </nav>
      </header>

      <!-- the stage is the same size on every page, so each page fades out and in where it sits -->
      <div class="stage" transition:name="stage" transition:animate={{ forwards: swap, backwards: swap }}>
        <main class="main">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
