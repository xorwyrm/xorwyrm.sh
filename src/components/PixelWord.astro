---
// A word as binary that rebuilds itself into pixel letters. Used for the name on the home page
// and the page titles. The bytes sit in a grid, three to a column; every square is placed
// twice: where it sits in the binary (a, b, c) and where it lands in its letter (x1, y1).
// [data-name="bit"] on <html> moves them; see global.css and main.ts. The word is a label for
// a hidden checkbox, so without JS it still flips when clicked (just not remembered).
// Sizes are in em of the element, so it scales with its font-size. The squares are SVG rects
// in a viewBox where one unit is 1em. CSS moves them by percentages of that box, not lengths:
// Chrome scales stored lengths when the page is zoomed, which would set every square moving.
// They're drawn with crisp edges, so the sizes are snapped to whole screen pixels (snapWord,
// Window.astro): the letters' pitch, and in the binary the square size and gap, which every
// binary position is built from (a squares and b gaps across, c of each down).

interface Props {
  word: string;
}
const { word } = Astro.props;

// 5×7 pixel letters; rows past the 7th are descenders. Add more as needed;
// unknown characters get a solid block.
const GLYPHS: Record<string, string[]> = {
  b: ['X....', 'X....', 'XXXX.', 'X...X', 'X...X', 'X...X', 'XXXX.'],
  g: ['.....', '.....', '.XXXX', 'X...X', 'X...X', 'X...X', '.XXXX', '....X', 'XXXX.'],
  h: ['X....', 'X....', 'XXXX.', 'X...X', 'X...X', 'X...X', 'X...X'],
  i: ['..X..', '.....', '.XX..', '..X..', '..X..', '..X..', '.XXX.'],
  k: ['X....', 'X....', 'X..X.', 'X.X..', 'XX...', 'X.X..', 'X..X.'],
  l: ['.XX..', '..X..', '..X..', '..X..', '..X..', '..X..', '.XXX.'],
  n: ['.....', '.....', 'XXXX.', 'X...X', 'X...X', 'X...X', 'X...X'],
  s: ['.....', '.....', '.XXXX', 'X....', '.XXX.', '....X', 'XXXX.'],
  t: ['.X...', '.X...', 'XXXX.', '.X...', '.X...', '.X..X', '..XX.'],
  '0': ['.XXX.', 'X...X', 'X..XX', 'X.X.X', 'XX..X', 'X...X', '.XXX.'],
  '4': ['...X.', '..XX.', '.X.X.', 'X..X.', 'XXXXX', '...X.', '...X.'],
};
const BLOCK = Array(7).fill('XXXXX');

const s = 0.2, g = 0.07; // binary: square size and the gap between squares
const P = 0.105; // letters: pixel pitch, and the size of each pixel
const ROWS = 3; // bytes per column
const byteW = 8 * s + 7 * g, colGap = s + g;
const chars = [...word];
const cols = Math.ceil(chars.length / ROWS);
const w0 = cols * byteW + (cols - 1) * colGap;
const w1 = chars.length * 6 * P - P; // one empty pixel column between letters
// tall enough for the letters, descenders included, so the gap below is the same for every word
const glyphRows = Math.max(...chars.map((c) => (GLYPHS[c] ?? BLOCK).length));
const h = Math.max(glyphRows * P, Math.min(chars.length, ROWS) * (s + g) - g);

const bytes = chars.map((c) => c.charCodeAt(0).toString(2).padStart(8, '0'));
const squares: { a: number; b: number; c: number; x1: number; y1: number; d: number; on: boolean; extra: boolean }[] = [];
chars.forEach((c, i) => {
  const glyph = GLYPHS[c] ?? BLOCK;
  const dots = glyph.flatMap((row, r) => [...row].flatMap((p, col) => (p === 'X' ? [[col, r]] : [])));
  const col = Math.floor(i / ROWS), row = i % ROWS;
  // the byte's 8 bits each take a dot; letters with more dots get extra squares that fade in
  for (let k = 0; k < Math.max(8, dots.length); k++) {
    const [dx, dy] = dots[Math.min(k, dots.length - 1)];
    const j = k % 8;
    // a column of bytes is 8 squares and 7 gaps wide, plus a square and a gap between columns
    squares.push({
      a: 9 * col + j, b: 8 * col + j, c: row,
      x1: i * 6 * P + dx * P, y1: dy * P,
      d: i * 110 + k * 9,
      on: k < 8 && bytes[i][j] === '1',
      extra: k >= 8,
    });
  }
});
const last = Math.max(...squares.map((q) => q.d));
const f = (n: number) => n.toFixed(3);
const wMax = Math.max(w0, w1);
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(4)}%`;
// snapWord sets the snapped sizes; these are unsnapped, until it does
const sizes = `--sx: ${pct(s, wMax)}; --gx: ${pct(g, wMax)}; --sy: ${pct(s, h)}; --gy: ${pct(g, h)}; --ks: 1`;
// a square's outline: four thin rects inside its edges, drawn once and reused by every square.
// not a stroke: any stroke in the svg makes Chrome blend every edge in it, crisp or not.
// about 1px thick here; snapWord makes it a whole number of screen pixels
const id = `edge-${Math.random().toString(36).slice(2, 8)}`;
const t = 1 / 62;
---

<label
  class="word"
  title={bytes.join(' ')}
  data-p={P}
  data-s={s}
  data-g={g}
  style={`--w0: ${f(w0)}em; --w1: ${f(w1)}em; --wm: ${f(wMax)}em; --h: ${f(h)}em; --k: ${f(P / s)}; ${sizes}`}
>
  <input type="checkbox" tabindex="-1" aria-hidden="true" />
  <svg viewBox={`0 0 ${f(wMax)} ${f(h)}`} aria-hidden="true">
    <defs>
      <g id={id}>
        <rect width={s} height={t} />
        <rect y={s - t} width={s} height={t} />
        <rect y={t} width={t} height={s - 2 * t} />
        <rect x={s - t} y={t} width={t} height={s - 2 * t} />
      </g>
    </defs>
    {squares.map((q) => (
      <g
        class:list={['sq', { on: q.on, extra: q.extra }]}
        style={`--a: ${q.a}; --b: ${q.b}; --c: ${q.c}; --x1: ${pct(q.x1, wMax)}; --y1: ${pct(q.y1, h)}; --d: ${q.d}ms; --dr: ${last - q.d}ms`}
      >
        <rect width={s} height={s} />
        <use class="edge" href={`#${id}`} />
      </g>
    ))}
  </svg>
</label>
<!-- before it's painted: snap the word's sizes to whole screen pixels (snapWord, Window.astro).
     page swaps and resizes are handled in main.ts -->
<script is:inline>snapWord(document.currentScript.previousElementSibling);</script>
